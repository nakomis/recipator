default_platform(:ios)

# Default TestFlight "What to Test" notes — written for a non-technical audience (family
# testers). Override per-build with `fastlane beta notes:"…"`. Keep it plain-English: what
# changed and what to try, never internals.
RELEASE_NOTES = <<~NOTES.freeze
  What's new:

  • You can now edit a saved recipe — tap the pencil at the top of a recipe to fix the title, change the ingredients or steps, or reorder them. Handy when the original page got something wrong or padded it out.
  • New Notes field for your own additions: “halve the chilli”, “needs a deeper tin”, whatever you'd have scribbled in the margin. Notes are searchable too.
  • Previous versions of a recipe are kept safely, so an edit can never lose the original.

  Please try editing a recipe (change a few ingredients, add a note) and let me know how it feels.
NOTES

# "What's New" for the App Store version record. Same news as the TestFlight notes, minus
# the "tell me how it goes" ask — this one is read by whoever installs from the store link.
APP_STORE_NOTES = <<~NOTES.freeze
  • You can now edit a saved recipe — tap the pencil at the top of a recipe to fix the title, change the ingredients or steps, or reorder them. Handy when the original page got something wrong or padded it out.
  • New Notes field for your own additions: “halve the chilli”, “needs a deeper tin”, whatever you'd have scribbled in the margin. Notes are searchable too.
  • Previous versions of a recipe are kept safely, so an edit can never lose the original.
NOTES

# App Store Connect API credentials: env vars on CI, local keychain on a dev machine.
def asc_api_key
  key_id      = ENV["ASC_KEY_ID"]      || `security find-generic-password -s app-store-connect -a key-id      -w 2>/dev/null`.strip
  issuer_id   = ENV["ASC_ISSUER_ID"]   || `security find-generic-password -s app-store-connect -a issuer-id   -w 2>/dev/null`.strip
  key_content = ENV["ASC_KEY_CONTENT"] || `security find-generic-password -s app-store-connect -a key-content -w 2>/dev/null`.strip
  app_store_connect_api_key(
    key_id:                key_id,
    issuer_id:             issuer_id,
    key_content:           key_content,
    is_key_content_base64: true,
  )
end

platform :ios do
  desc "Create (or reuse) the App Store version record and set its What's New notes"
  lane :prepare_version do |options|
    version = options[:version] or UI.user_error!("Pass version: e.g. `fastlane prepare_version version:1.1`")
    notes   = options[:notes] || APP_STORE_NOTES

    api_key = asc_api_key
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      key:       Base64.decode64(api_key[:key]),
    )

    app = Spaceship::ConnectAPI::App.find("com.nakomis.recipator")
    edit = app.get_edit_app_store_version

    if edit.nil?
      UI.message("No editable version — creating #{version}…")
      edit = app.create_version!(version_string: version.to_s)
    elsif edit.version_string != version.to_s
      UI.message("Editable version is #{edit.version_string} — renaming to #{version}…")
      edit = edit.update(attributes: { versionString: version.to_s })
    else
      UI.message("Version #{version} already exists in #{edit.app_store_state} — reusing it.")
    end

    edit.get_app_store_version_localizations.each do |loc|
      loc.update(attributes: { whatsNew: notes })
      UI.message("What's New set for #{loc.locale}")
    end

    UI.success("Version #{version} ready (#{edit.app_store_state}).")
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      scheme:      "Recipator (Sandbox)",
      destination: "platform=iOS Simulator,name=iPhone 16",
    )
  end

  desc "Upload an already-built IPA to TestFlight (skips rebuild)"
  lane :upload do |options|
    asc_key_id      = ENV["ASC_KEY_ID"]      || `security find-generic-password -s app-store-connect -a key-id      -w 2>/dev/null`.strip
    asc_issuer_id   = ENV["ASC_ISSUER_ID"]   || `security find-generic-password -s app-store-connect -a issuer-id   -w 2>/dev/null`.strip
    asc_key_content = ENV["ASC_KEY_CONTENT"] || `security find-generic-password -s app-store-connect -a key-content -w 2>/dev/null`.strip

    api_key = app_store_connect_api_key(
      key_id:                asc_key_id,
      issuer_id:             asc_issuer_id,
      key_content:           asc_key_content,
      is_key_content_base64: true,
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "Recipator.ipa",
      changelog:                         options[:notes] || RELEASE_NOTES,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Poll App Store Connect until the given build (default: this commit's) finishes processing"
  lane :wait_processed do |options|
    asc_key_id      = ENV["ASC_KEY_ID"]      || `security find-generic-password -s app-store-connect -a key-id      -w 2>/dev/null`.strip
    asc_issuer_id   = ENV["ASC_ISSUER_ID"]   || `security find-generic-password -s app-store-connect -a issuer-id   -w 2>/dev/null`.strip
    asc_key_content = ENV["ASC_KEY_CONTENT"] || `security find-generic-password -s app-store-connect -a key-content -w 2>/dev/null`.strip

    api_key = app_store_connect_api_key(
      key_id:                asc_key_id,
      issuer_id:             asc_issuer_id,
      key_content:           asc_key_content,
      is_key_content_base64: true,
    )

    target = (options[:build] || `git rev-list HEAD --count`.strip).to_s
    UI.message("Waiting for build #{target} to reach processingState=VALID on App Store Connect…")

    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    asc_key_id,
      issuer_id: asc_issuer_id,
      key:       Base64.decode64(asc_key_content),
    )
    app = Spaceship::ConnectAPI::App.find("com.nakomis.recipator")

    loop do
      build = Spaceship::ConnectAPI.get_builds(
        filter:   { app: app.id, version: target },
        includes: "",
      ).first
      state = build&.processing_state
      UI.message("build #{target} processingState: #{state.inspect}")
      raise "Build #{target} processing FAILED/INVALID (#{state})" if %w[FAILED INVALID].include?(state)
      break if state == "VALID"
      sleep 45
    end
    UI.success("Build #{target} has finished processing (VALID) — ready to submit.")
  end

  desc "Attach the latest processed build to the current App Store version and submit for review"
  lane :submit do |options|
    asc_key_id      = ENV["ASC_KEY_ID"]      || `security find-generic-password -s app-store-connect -a key-id      -w 2>/dev/null`.strip
    asc_issuer_id   = ENV["ASC_ISSUER_ID"]   || `security find-generic-password -s app-store-connect -a issuer-id   -w 2>/dev/null`.strip
    asc_key_content = ENV["ASC_KEY_CONTENT"] || `security find-generic-password -s app-store-connect -a key-content -w 2>/dev/null`.strip

    api_key = app_store_connect_api_key(
      key_id:                asc_key_id,
      issuer_id:             asc_issuer_id,
      key_content:           asc_key_content,
      is_key_content_base64: true,
    )

    # Attach a specific build (default: this commit's build number) to the live
    # version record and submit for review. Metadata/screenshots untouched.
    build_number = options[:build] || `git rev-list HEAD --count`.strip

    deliver(
      api_key:             api_key,
      # Target an explicit version when given (`fastlane submit version:1.1`), so the build
      # lands on the version record prepare_version created rather than whatever is editable.
      app_version:         options[:version],
      build_number:        build_number,
      submit_for_review:   true,
      automatic_release:   true,
      skip_binary_upload:  true,
      skip_metadata:       true,
      skip_screenshots:    true,
      force:               true,
      # precheck's URL check uses HEAD; nakom.is/privacy-policy answers HEAD with 405
      # (CloudFront) but GET with 200 — a false positive that wrongly blocks submission.
      run_precheck_before_submit:        false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
      },
    )
  end

  desc "Build and upload to TestFlight (production scheme)"
  lane :beta do |options|
    ensure_git_status_clean

    # Prefer env vars (CI) then fall back to local keychain (dev machine)
    asc_key_id      = ENV["ASC_KEY_ID"]      || `security find-generic-password -s app-store-connect -a key-id      -w 2>/dev/null`.strip
    asc_issuer_id   = ENV["ASC_ISSUER_ID"]   || `security find-generic-password -s app-store-connect -a issuer-id   -w 2>/dev/null`.strip
    asc_key_content = ENV["ASC_KEY_CONTENT"] || `security find-generic-password -s app-store-connect -a key-content -w 2>/dev/null`.strip

    api_key = app_store_connect_api_key(
      key_id:                asc_key_id,
      issuer_id:             asc_issuer_id,
      key_content:           asc_key_content,
      is_key_content_base64: true,
    )

    # Build number = number of commits — monotonically increasing,
    # no App Store Connect API call needed locally.
    build_number = `git rev-list HEAD --count`.strip
    increment_build_number(
      build_number:  build_number,
      xcodeproj:     "Recipator.xcodeproj",
    )

    build_app(
      scheme:        "Recipator (Production)",
      configuration: "Release Production",
      export_method: "app-store",
      export_xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight(
      api_key:                           api_key,
      changelog:                         options[:notes] || RELEASE_NOTES,
      skip_waiting_for_build_processing: true,
    )
  ensure
    # Restore Info.plists modified by increment_build_number — build number is
    # tracked by App Store Connect, not git.
    reset_git_repo(
      files:       ["Recipator/Resources/Info.plist", "RecipatorShare/Info.plist"],
      skip_clean:  true,
    )
  end
end

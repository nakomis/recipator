default_platform(:ios)

platform :ios do
  desc "Run unit tests"
  lane :test do
    run_tests(
      scheme:      "Recipator (Sandbox)",
      destination: "platform=iOS Simulator,name=iPhone 16",
    )
  end

  desc "Build and upload to TestFlight (production scheme)"
  lane :beta do
    ensure_git_status_clean

    # Prefer env vars (CI) then fall back to local keychain (dev machine)
    asc_key_id      = ENV["ASC_KEY_ID"]      || `security find-generic-password -s app-store-connect -a key-id      -w 2>/dev/null`.strip
    asc_issuer_id   = ENV["ASC_ISSUER_ID"]   || `security find-generic-password -s app-store-connect -a issuer-id   -w 2>/dev/null`.strip
    asc_key_content = ENV["ASC_KEY_CONTENT"] || `security find-generic-password -s app-store-connect -a key-content -w 2>/dev/null`.strip

    api_key = app_store_connect_api_key(
      key_id:                asc_key_id,
      issuer_id:             asc_issuer_id,
      key_content:           asc_key_content,
      is_key_content_base64: true,
    )

    # Build number = number of commits — monotonically increasing,
    # no App Store Connect API call needed locally.
    build_number = `git rev-list HEAD --count`.strip
    increment_build_number(
      build_number:  build_number,
      xcodeproj:     "Recipator.xcodeproj",
    )

    build_app(
      scheme:        "Recipator (Production)",
      configuration: "Release Production",
      export_method: "app-store",
      export_xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
    )
  ensure
    # Restore Info.plists modified by increment_build_number — build number is
    # tracked by App Store Connect, not git.
    reset_git_repo(
      files:       ["Recipator/Resources/Info.plist", "RecipatorShare/Info.plist"],
      skip_clean:  true,
    )
  end
end
